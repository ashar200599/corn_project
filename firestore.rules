rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.get('photoURL', '') == '' || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (data.get('vitals', null) == null || (
               data.vitals is map && 
               data.vitals.get('health', 0) is number &&
               data.vitals.get('shield', 0) is number &&
               data.vitals.get('attack', 0) is number
             ));
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['recipeId', 'addedAt']) &&
             data.keys().size() == 2 &&
             data.recipeId is string && data.recipeId.size() <= 100;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) && 
                      incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().createdAt == existing().createdAt &&
                      (
                        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin', 'vitals'])
                      ) &&
                      incoming().lastLogin == request.time;

      // 2. Favorites Sub-collection
      match /favorites/{recipeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidId(recipeId) && 
                        isValidFavorite(incoming()) && 
                        incoming().addedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}

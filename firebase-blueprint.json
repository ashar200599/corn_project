{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public profile information for a user",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "vitals": {
          "type": "object",
          "properties": {
            "health": { "type": "number" },
            "shield": { "type": "number" },
            "attack": { "type": "number" }
          }
        }
      },
      "required": ["displayName", "createdAt"]
    },
    "Favorite": {
      "title": "Favorite Recipe",
      "description": "A recipe saved by the user",
      "type": "object",
      "properties": {
        "recipeId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipeId", "addedAt"]
    },
    "DishReview": {
      "title": "Dish Review",
      "description": "User review and rating for a dish",
      "type": "object",
      "properties": {
        "dishId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dishId", "userId", "displayName", "rating", "text", "createdAt"]
    }
  },
  "firestore": {
    "dish_reviews/{reviewId}": {
      "schema": "DishReview",
      "description": "Reviews for dishes under root container"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "users/{userId}/favorites/{recipeId}": {
      "schema": "Favorite",
      "description": "User's favorite recipes"
    }
  }
}
